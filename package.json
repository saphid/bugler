{
  "name": "bugler",
  "version": "0.1.0",
  "description": "A storage-neutral event relay that wakes agents when verified events arrive.",
  "repository": {
    "type": "git",
    "url": "https://github.com/saphid/bugler.git"
  },
  "homepage": "https://bugler.dev",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bugler": "src/bugler.ts"
  },
  "scripts": {
    "bugler": "bun run src/bugler.ts",
    "start": "bun run src/bugler.ts serve",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:core && bun run test:workers && bun run test:dynamodb && bun run test:cosmos && bun run test:firestore",
    "test:core": "bun test tests/*.test.ts",
    "test:workers": "vitest run",
    "test:daemon-mcp": "bun test tests/daemon-mcp.test.ts",
    "test:dynamodb": "bash scripts/test-dynamodb.sh",
    "test:cosmos": "bash scripts/test-cosmos.sh",
    "test:firestore": "bash scripts/test-firestore.sh",
    "test:watch": "bun test --watch",
    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1116.0",
    "@aws-sdk/lib-dynamodb": "^3.1116.0",
    "@azure/core-rest-pipeline": "^1.25.0",
    "@azure/cosmos": "^4.10.0",
    "@google-cloud/firestore": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.9.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "^5.20260822.1",
    "@types/bun": "^1.2.21",
    "typescript": "^5.9.2",
    "vitest": "4.1.0",
    "wrangler": "4.125.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
